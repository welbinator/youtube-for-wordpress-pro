parameters:
  phpVersion: 80000
  paths:
    - .
  excludePaths:
    - vendor
    - node_modules
    - build
    - assets
    - EDD_SL_Plugin_Updater.php
    - EDD_Licensing.php
    - github-update.php
  level: 5
  bootstrapFiles:
    - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
  dynamicConstantNames:
    - WP_DEBUG
    - YOUTUBEFORWORDPRESSPRO_PLUGIN_LICENSE_PAGE
  ignoreErrors:
    - '#callable\(\): mixed#'
  reportUnmatchedIgnoredErrors: false
includes:
  - phpstan-baseline.neon
