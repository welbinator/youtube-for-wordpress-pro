<?xml version="1.0"?>
<ruleset name="YouTube for WordPress Pro">
  <description>PHPCS rules for YouTube for WordPress Pro</description>

  <!-- Scan these files/dirs -->
  <file>.</file>

  <!-- Exclude these -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/assets/*</exclude-pattern>

  <!-- Use WordPress Coding Standards -->
  <rule ref="WordPress">
    <!-- Allow short array syntax -->
    <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
  </rule>

  <!-- WordPress minimum version -->
  <config name="minimum_supported_wp_version" value="6.0"/>
  <config name="testVersion" value="8.0-"/>

  <!-- Text domain -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="youtube-for-wordpress-pro"/>
    </properties>
  </rule>
</ruleset>
